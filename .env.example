# Copiar a `.env` y ajustar.
TALLER_ENVIRONMENT=dev

# --- Base de datos -----------------------------------------------------------
# Motor: postgresql | mysql  (mysql sirve también para MariaDB).
# La lógica de la app es la misma con los dos; cambiar de motor apunta a OTRA
# base (los datos no se mueven solos). Base nueva: `alembic upgrade head` y
# `python -m scripts.seed_catalogos`, o importar deploy/taller_inicial_mariadb.sql.
TALLER_DB_MOTOR=postgresql
TALLER_DB_HOST=localhost
# Sin definir = puerto por defecto del motor (5432 PostgreSQL, 3306 MySQL).
# TALLER_DB_PUERTO=5432
TALLER_DB_USUARIO=taller
TALLER_DB_PASSWORD=taller
TALLER_DB_NOMBRE=taller
# Opcional: URL completa; si se define, manda sobre las variables de arriba.
# TALLER_DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/taller?charset=utf8mb4

# Ejemplo MySQL/MariaDB (XAMPP o hosting):
# TALLER_DB_MOTOR=mysql
# TALLER_DB_HOST=127.0.0.1
# TALLER_DB_USUARIO=root
# TALLER_DB_PASSWORD=
# TALLER_DB_NOMBRE=taller

# --- Frontend y CORS (hosting en subdominios distintos) ----------------------
# URL pública del frontend (HTTPS). Se agrega automáticamente a CORS.
# TALLER_FRONTEND_URL=https://app.tudominio.com
# Orígenes extra (JSON). En dev suelen bastar localhost; en prod conviene TALLER_FRONTEND_URL.
TALLER_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Seguridad ---------------------------------------------------------------
# Generar con: .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
TALLER_JWT_SECRET=cambiar-este-secreto-por-uno-de-32-bytes-minimo
TALLER_ACCESS_TOKEN_MINUTES=60

# --- Archivos y tareas (opcionales, valores por defecto) ---------------------
# TALLER_STORAGE_DIR=var/archivos
# TALLER_MAX_UPLOAD_MB=50
# TALLER_CUMPLIMIENTO_ACTIVO=true
# TALLER_CUMPLIMIENTO_MINUTOS=15
# TALLER_COMPROBANTE_PENDIENTE_DIAS=3
# TALLER_ARCA_DIR=var/arca
